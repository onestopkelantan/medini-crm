# ============================================================================
# Medini CRM — PRODUCTION Environment Template (S10 T2)
# Copy to .env.production and fill with REAL secrets. NEVER commit .env.production.
# ============================================================================

# ---- Domain ----
DOMAIN=crm.medini.example.com          # Production domain (Caddy Let's Encrypt)

# ---- PostgreSQL ----
POSTGRES_DB=medini_prod
POSTGRES_PASSWORD=                     # STRONG password for owner role (medini)
POSTGRES_APP_PASSWORD=                 # STRONG password for runtime role (medini_app)

# ---- Redis ----
REDIS_PASSWORD=                        # STRONG password for Redis

# ---- JWT / Auth ----
JWT_SECRET=                            # STRONG random (>= 32 chars)
JWT_REFRESH_SECRET=                    # STRONG random (>= 32 chars, different from JWT_SECRET)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ---- Backup ----
BACKUP_RETENTION_DAYS=30               # Daily backups retained for 30 days

# ---- WAHA (WhatsApp) — only if launch scope ----
# WAHA_BASE_URL=http://waha:3000
# WAHA_API_KEY=

# ---- Bukku (accounting) — only if launch scope ----
# BUKKU_BASE_URL=https://api.bukku.my
# BUKKU_API_KEY=
# BUKKU_COMPANY_SUBDOMAIN=

# ---- AI Provider — only if launch scope ----
# AI_PROVIDER_BASE_URL=
# AI_PROVIDER_API_KEY=

# ---- Logging ----
LOG_LEVEL=info
