# ============================================================================
# Medini CRM Backend — PRODUCTION Dockerfile (S10 T2)
# Multi-stage: deps → build → runtime (non-root, minimal surface).
# NOTE: wget is available in alpine (busybox) — no extra install needed.
# ============================================================================

FROM node:20-alpine AS base
WORKDIR /app

# ---- deps: install production dependencies only (build tools for argon2 native) ----
FROM base AS deps
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund

# ---- build: install dev deps + compile TypeScript (build tools for argon2) ----
FROM base AS build
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
# The ACTIVE migration folder is drizzle-mysql (the runtime is MySQL 8.4). It was
# not copied before, so the image shipped no migrations at all and a fresh deploy
# could not build its schema.
COPY drizzle-mysql ./drizzle-mysql
RUN npm run build

# ---- runtime: non-root, production deps + compiled output only ----
FROM base AS runtime
ENV NODE_ENV=production
RUN addgroup -S medini && adduser -S medini -G medini
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/drizzle-mysql ./drizzle-mysql
COPY package.json ./
USER medini
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/health/ready || exit 1
# Apply pending migrations, then start. The `&&` is the point: if the schema
# cannot be brought up to date, the container must NOT serve traffic against a
# database it does not understand. Migrations are recorded in
# medini_schema_migrations, so a restart after the first is a no-op.
CMD ["sh", "-c", "node dist/infrastructure/database/migrate.js && node dist/main.js"]
