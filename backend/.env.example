# ==========================================================================
# MEDINI CRM BACKEND — EXAMPLE ENVIRONMENT (NO REAL SECRETS)
# Copy to .env for local development. NEVER commit real credentials.
# ==========================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# --- Database (MySQL 8.4) — dev placeholder only ---
# DATABASE_URL = admin/owner connection (migrations + seed). Local compose binds
# MySQL to 127.0.0.1:3306 unless you override the port.
DATABASE_URL=mysql://medini:change_me@localhost:3306/medini_dev
# DATABASE_RUNTIME_URL = restricted application runtime connection. Production
# must use a separate non-owner account and real secret via env/secrets.
DATABASE_RUNTIME_URL=mysql://medini_app:change_me@localhost:3306/medini_dev
# DEV/TEST only: seeds the 4 demo users. Never set this in production.
# Left blank deliberately — put a local value in .env, which is gitignored.
SEED_DEMO_PASSWORD=change_me_locally

# --- Redis (queue + cache) — dev placeholder only ---
REDIS_URL=redis://localhost:6379

# --- Auth (JWT) — dev placeholders ONLY; override via secrets in staging/prod ---
JWT_SECRET=dev_only_insecure_jwt_secret_change_me
JWT_REFRESH_SECRET=dev_only_insecure_refresh_secret_change_me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- Object storage (S3-compatible) — dev placeholders ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=medini-dev
S3_ACCESS_KEY=dev_only_access_key
S3_SECRET_KEY=dev_only_secret_key

# --- WAHA (WhatsApp transport) ---
# Internal service URL (Docker network). WAHA is never exposed publicly.
WAHA_BASE_URL=http://waha:3000
# API key required by every WAHA request. Prefer the sha512: form in production.
WAHA_API_KEY=
# Freshness window (seconds) advertised to the UI for the pairing QR. The UI
# re-fetches ahead of this so a scannable code is always on screen.
WAHA_QR_TTL_SECONDS=60

# --- Bukku (accounting) — NEVER hardcode; leave empty locally; real via secrets ---
BUKKU_BASE_URL=https://api.bukku.my
BUKKU_API_KEY=
BUKKU_COMPANY_SUBDOMAIN=

# --- Sprint 8 integration runtime ---
# Canonical organisation id — required by the recovery scheduler (F-03/F-04/F-08)
# to establish its trusted org scope. Single-tenant deployment: the one org.
MEDINI_ORG_ID=
# Recovery sweep interval (minutes). The repeatable BullMQ 'recovery-tick' job
# re-enqueues stranded WhatsApp/outbox/recall/Bukku work after a Redis outage.
RECOVERY_SWEEP_INTERVAL_MINUTES=60
# TEST ONLY: set to 1 to skip the D18 randomized 30–60s WhatsApp send delay.
# Never set in production.
# WA_SEND_DELAY_DISABLE=

# --- AI provider (MiniMax) — placeholders only ---
# MINIMAX_API_KEY is the name the WhatsApp bot + Playground adapter read.
# Without it the Playground returns 'MINIMAX_API_KEY not set' rather than a
# reply — it never fabricates an answer.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
# Override only for a proxy / self-hosted endpoint (default = MiniMax cloud).
MINIMAX_BASE_URL=https://api.minimax.io/v1/text/chatcompletion_v2
# Legacy aliases — read as a fallback when the MINIMAX_* value is empty.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=

# --- Logging ---
LOG_LEVEL=debug

# --- Rate limiting / trusted proxy (S10 F-03) ---
# Comma-separated IPs/CIDRs allowed to supply X-Forwarded-For for the auth
# rate limiter. EMPTY (default) = trust nobody: the header is ignored and the
# socket peer is the bucket key (fail-closed — safe but one shared bucket
# behind an unlisted proxy). Production behind Caddy: the Docker bridge CIDR.
# TRUSTED_PROXIES=172.16.0.0/12
