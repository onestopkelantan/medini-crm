# ---- Object storage (Garage) ----
# MinIO was the plan until its Docker Hub repos were deleted (11 Sep 2026) and
# the project was archived. Garage is the maintained replacement; see garage.toml.
# These are generated locally and never leave this file.
GARAGE_RPC_SECRET=092f42bb5ddb949e796d8d96caaf0d7b5596d31455e9d53db09b188805564317
GARAGE_ADMIN_TOKEN=jpiWV8uXC99qePnlmMWhZGocISqKS8eHaK/Csspa4qo=
S3_BUCKET=medini-prod
S3_REGION=garage
GARAGE_S3_ACCESS_KEY=GK20c5ed791bcd953df5b99410
GARAGE_S3_SECRET_KEY=9d2f4d6b2616bee48d21a34f8a6297b4c7207ffa4cb021dca7b48e57183e7068
# Hos yang ditandatangan utk URL presigned (mesti boleh dicapai pelayar).
# Laluan /files dalam Caddy memetakan ke garage:3900 tanpa awalan.
# Hos yang DITANDATANGAN utk URL presigned. Mesti URL penuh — S3 SDK menolak
# nilai tanpa skema ("Invalid URL"), dan URL presigned ialah tandatangan atas HOS,
# jadi ia mesti hos sebenar yang pelayar boleh capai.
# Laluan /files dalam Caddy memetakan ke garage:3900 dan mengupas awalan itu.
# Hos yang DITANDATANGAN utk URL presigned. TANPA laluan tambahan: laluan gaya
# S3 sudah bermula dgn nama bucket, dan menambah awalan di sini membuat Garage
# membaca awalan itu SEBAGAI nama bucket (NoSuchBucket) sambil merosakkan
# tandatangan (403 Invalid signature).
S3_PUBLIC_ENDPOINT=http://localhost:8080

